// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

enum TransactionType {
  INCOME
  EXPENSE
  // money back for a purchase; stored positive, subtracted from its category's spend
  REFUND
}

enum Currency {
  USD
  EUR
  UAH
  GBP
  PLN
}

enum ImportStatus {
  PENDING
  CONFIRMED
}

generator client {
  provider = "prisma-client"
  previewFeatures = ["relationJoins"]
  logLevel = "query"
  output   = "../src/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String         @id @default(uuid())
  userName    String         @map("user_name")
  userSurname String         @map("user_surname")
  userEmail   String         @unique @map("user_email")
  passwordHash String?       @map("password_hash")
  provider     String?       @map("provider")      
  providerId   String?       @map("provider_id") 
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  categoryMappings  CategoryMapping[]
  tags              Tag[]

  @@unique([provider, providerId])
}

model Account {
  id        String      @id @default(uuid())
  name      String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id])

  transactions Transaction[]

  @@unique([userId, name])
}

model Category {
  id        String      @id @default(uuid())
  name      String
  icon      String?
  color     String?
  isDefault Boolean     @default(false) @map("is_default")
  // the one category per user for moves between own accounts: excluded from charts, positive rows stay INCOME
  isTransfer Boolean    @default(false) @map("is_transfer")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id])

  transactions     Transaction[]
  categoryMappings CategoryMapping[]

  @@unique([userId, name])
}

model Transaction {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  description  String?
  amount       Decimal  @db.Decimal(12, 2)
  currency     Currency
  type         TransactionType
  date         DateTime
  // hash of (date, |amount|, normalised description); used to skip re-importing the same row
  fingerprint  String?  @map("fingerprint")
  // soft delete: hidden everywhere, but kept so re-imports still see it as a duplicate
  deletedAt    DateTime? @map("deleted_at")

  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id])

  categoryId   String?     @map("category_id")
  category     Category?   @relation(fields: [categoryId], references: [id])

  accountId    String     @map("account_id")
  account      Account    @relation(fields: [accountId], references: [id])

  tags         TransactionTag[]

  @@index([accountId, fingerprint])
  @@index([userId, date])
  @@index([accountId, date])
  @@index([categoryId, date])
}

model TransactionImportRow {
  id          String   @id @default(uuid())
  importId    String   @map("import_id")

  date        DateTime
  description String
  amount      Decimal  @db.Decimal(12, 2)

  categoryId  String?  @map("category_id") // user fills later

  import TransactionImport @relation(fields: [importId], references: [id])
}


model TransactionImport {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  status    ImportStatus @default(PENDING)

  rows      TransactionImportRow[]
}

// Groups transactions across categories, e.g. "Spain trip 2026"
model Tag {
  id        String   @id @default(uuid())
  // unique per user ignoring case; the service enforces that, the index only blocks exact duplicates
  name      String
  color     String?
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  transactions TransactionTag[]

  @@unique([userId, name])
}

model TransactionTag {
  transactionId String      @map("transaction_id")
  tagId         String      @map("tag_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

// Remembers which category a user last assigned to a given transaction description.
model CategoryMapping {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  description String   // normalised: lowercased + trimmed
  categoryId  String   @map("category_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, description])
  @@index([userId])
}




